<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Panel Administrador</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="~/Content/AdminStyles.css" rel="stylesheet" />
</head>
<body>

    <div class="panel-container">

        <div class="d-flex justify-content-between align-items-center mb-5 pt-3">
            <h1 class="panel-title">Panel del Administrador</h1>
            
        </div>

        <div class="row g-4 mb-5">

            <div class="col-md-4">
                <a href="@Url.Action("Index", "Usuario")" class="card-link">
                    <div class="bg-primary text-white card-option">
                        <div class="icon-large">👥</div>
                        <h5>Usuarios</h5>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a href="@Url.Action("Lista", "Producto")" class="card-link">
                    <div class="bg-success text-white card-option">
                        <div class="icon-large">📦</div>
                        <h5>Productos</h5>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a href="@Url.Action("Create", "Usuario")" class="card-link">
                    <div class="bg-info text-white card-option">
                        <div class="icon-large">➕</div>
                        <h5>Crear Cuenta</h5>
                    </div>
                </a>
            </div>
        </div>

        <hr class="my-4">

        <div class="main-content">
            @RenderBody()
        </div>

    </div>
