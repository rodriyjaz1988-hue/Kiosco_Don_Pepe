@{
    ViewBag.Title = "Carrito";
    Layout = null; // ❌ Desactivamos el Layout para tener fondo personalizado
}

@model List<Kiosco_Don_Pepe.Controllers.CarritoItem>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - Kiosco Don Pepe</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        /* 🌈 Fondo degradado general */
        body {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            background-attachment: fixed;
            background-size: cover;
            min-height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem;
        }

        /* 💎 Tarjeta principal */
        .glass-card-carrito {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(12px);
            border-radius: 1.5rem;
            padding: 2.5rem 3rem;
            max-width: 900px;
            width: 100%;
            color: white;
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.5);
        }

            .glass-card-carrito:hover {
                transform: translateY(-6px);
            }

        /* 🧾 Tabla */
        .table {
            color: #fff;
            border-color: rgba(255, 255, 255, 0.25);
            vertical-align: middle;
        }

            .table thead th {
                border-bottom: 2px solid rgba(255, 255, 255, 0.3);
            }

        .table-hover tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        /* 🧈 Botones */
        .btn {
            transition: all 0.3s ease;
            font-weight: bold;
        }

            .btn:hover {
                transform: scale(1.07);
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
            }

        /* ✨ Total general */
        h3 {
            color: #f8f9fa;
            margin-top: 1.5rem;
            font-weight: bold;
        }

        /* 🔔 Alerta vacía */
        .alert-warning {
            background-color: rgba(255, 193, 7, 0.2);
            border: 1px solid rgba(255, 193, 7, 0.4);
            color: #fff;
        }
    </style>
</head>
<body>

    <div class="glass-card-carrito animate__animated animate__fadeInUp">
        <h2 class="mb-4 display-6">🛒 Carrito de compras</h2>

        <p>
            <a class="btn btn-primary btn-lg" href="@Url.Action("lista", "Producto")">Seguir comprando</a>
        </p>

        @if (Model.Count == 0)
        {
            <div class="alert alert-warning mt-4">No hay productos en el carrito.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Precio</th>
                            <th>Cantidad</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>$@item.Precio</td>
                                <td>@item.Cantidad</td>
                                <td>$@item.Total</td>
                                <td>
                                    @Html.ActionLink("Eliminar", "Eliminar", "Carrito", new { idProducto = item.IdProducto }, new { @class = "btn btn-danger btn-sm" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h3>Total general: $@Model.Sum(x => x.Total)</h3>

            <div class="mt-4 d-flex justify-content-center gap-3">
                @Html.ActionLink("Finalizar compra", "FinalizarCompra", "Carrito", null, new { @class = "btn btn-success btn-lg" })
                @Html.ActionLink("Volver al inicio", "Index", "Usuarios", null, new { @class = "btn btn-light btn-lg" })
            </div>
        }
    </div>

</body>
</html>
