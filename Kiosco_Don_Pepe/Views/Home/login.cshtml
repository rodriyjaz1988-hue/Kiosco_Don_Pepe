@{
    // 1. IMPORTANTE: Usamos Layout = null para que la página sea limpia y sin el menú de navegación
    Layout = null;
    ViewBag.Title = "Iniciar Sesión";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Kiosco Don Pepe</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>

<body>
    @* Contenedor que aplica el centrado y el fondo *@
    <div class="login-simple-container">

        @* La tarjeta que envuelve tu formulario *@
        <div class="login-simple-card">

            <h2>Iniciar Sesión</h2>

            @using (Html.BeginForm("Login", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div>
                    <label>Email</label>
                    <input type="text" name="Email" required />
                </div>

                <div>
                    <label>Contraseña</label>
                    <input type="password" name="Password" required />
                </div>

                <button type="submit">Ingresar</button>
            }

            @if (ViewBag.Error != null)
            {
                <p style="color:red">@ViewBag.Error</p>
            }

            <hr />

            <p class="text-center">
                ¿No tienes cuenta?
                @Html.ActionLink("Regístrate aquí", "Cuenta", "CrearCuenta")
            </p>

        </div> @* Cierre de .login-simple-card *@
    </div> @* Cierre de .login-simple-container *@

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>