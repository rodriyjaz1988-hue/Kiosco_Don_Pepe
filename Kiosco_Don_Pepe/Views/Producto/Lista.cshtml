@model IEnumerable<Kiosco_Don_Pepe.Producto>

@{
    Layout = null;
    ViewBag.Title = "Lista de Productos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - Kiosco Don Pepe</title>

    <!-- Bootstrap + Animate.css -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        /* 🌈 Fondo degradado global */
        body {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            background-attachment: fixed;
            background-size: cover;
            min-height: 100vh;
            margin: 0;
            /* 🧭 Centrado vertical y horizontal */
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem;
        }

        /* 💎 Tarjeta principal */
        .glass-card-lista {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(12px);
            border-radius: 1.5rem;
            padding: 3rem;
            max-width: 900px;
            width: 100%;
            color: #fff;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .glass-card-lista:hover {
                transform: translateY(-6px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
            }

        /* 🧾 Tabla */
        .table {
            color: #fff;
            border-color: rgba(255, 255, 255, 0.25);
            vertical-align: middle;
            text-align: center;
        }

            .table thead th {
                border-bottom: 2px solid rgba(255, 255, 255, 0.3);
                text-transform: uppercase;
            }

        .table-hover tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        /* 🧈 Botones */
        .btn {
            transition: all 0.3s ease;
        }

            .btn:hover {
                transform: scale(1.07);
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
            }

        /* 🧮 Input cantidad */
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type="number"] {
            width: 80px;
            text-align: center;
            border-radius: 20px;
            background-color: rgba(0, 0, 0, 0.3);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
    </style>
</head>

<body>
    <div class="glass-card-lista animate__animated animate__fadeInUp shadow-lg">
        <h2 class="display-6 fw-bold mb-4 text-center">🛍️ Productos Disponibles</h2>

        <div class="text-center mb-4">
            @Html.ActionLink("🧺 Ir al carrito", "VerCarrito", "Carrito", null, new { @class = "btn btn-warning btn-lg rounded-pill fw-bold shadow" })
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Agregar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td>$@item.Precio</td>
                            <td>@item.Stock</td>
                            <td>
                                @using (Html.BeginForm("AgregarCarrito", "Carrito", FormMethod.Post, new { @class = "d-inline-flex justify-content-center align-items-center gap-2" }))
                                {
                                    @Html.Hidden("idProducto", item.IdProducto)
                                    <input type="number" name="cantidad" min="1" max="@item.Stock" value="1" />
                                    <input type="submit" value="Agregar" class="btn btn-success rounded-pill fw-bold shadow" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
