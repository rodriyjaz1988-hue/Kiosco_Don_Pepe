@model Kiosco_Don_Pepe.Usuario

@{
    ViewBag.Title = "Detalles del Usuario";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - Kiosco Don Pepe</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        body {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            background-attachment: fixed;
            background-size: cover;
            min-height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            color: #fff;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(15px);
            border-radius: 1.5rem;
            padding: 3rem;
            width: 100%;
            max-width: 500px;
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .glass-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
            }

        h2 {
            color: #ffd700;
            font-weight: bold;
            margin-bottom: 1rem;
        }

        dt {
            color: #00ffff;
            font-weight: 600;
        }

        dd {
            margin-bottom: 0.8rem;
        }

        .btn {
            transition: all 0.3s ease;
        }

            .btn:hover {
                transform: scale(1.07);
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
            }
    </style>
</head>

<body>
    <div class="glass-card animate__animated animate__fadeInUp shadow-lg">
        <h2>Detalles del Usuario</h2>
        <hr class="mb-4" />

        <dl class="text-start">
            <dt>Nombre</dt>
            <dd>@Model.Nombre</dd>

            <dt>Email</dt>
            <dd>@Model.Email</dd>

            <dt>Contraseña</dt>
            <dd>@Model.Password</dd>

            <dt>Tipo de Usuario</dt>
            <dd>@Model.TipoUsuario</dd>
        </dl>

        <div class="mt-4">
            @Html.ActionLink("Editar", "Edit", "Usuario", new { id = Model.IdUsuario }, new { @class = "btn btn-warning me-2" })
            @Html.ActionLink("Volver a la lista", "Index", "Usuario", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</body>
</html>
