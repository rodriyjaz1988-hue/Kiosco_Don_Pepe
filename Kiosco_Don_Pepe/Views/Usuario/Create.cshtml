@model Kiosco_Don_Pepe.Usuario

@{
    ViewBag.Title = "Crear Usuario";
    Layout = null; /* 👉 Sacamos el layout para que no desplace el centrado */
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - Kiosco Don Pepe</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
</head>

<body>
    <div class="d-flex justify-content-center align-items-center vh-100"
         style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);">

        <div class="glass-card-crear animate__animated animate__fadeInUp shadow-lg" style="width: 100%; max-width: 500px;">
            <h2 class="text-center mb-4 text-white">🧍 Crear nuevo usuario</h2>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    @Html.LabelFor(model => model.Nombre, "Nombre", new { @class = "form-label fw-bold text-white" })
                    @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control", placeholder = "Ingrese nombre" } })
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Email, "Email", new { @class = "form-label fw-bold text-white" })
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "usuario@correo.com" } })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Password, "Contraseña", new { @class = "form-label fw-bold text-white" })
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", type = "password", placeholder = "********" } })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.TipoUsuario, "Tipo de Usuario", new { @class = "form-label fw-bold text-white" })
                    @Html.EditorFor(model => model.TipoUsuario, new { htmlAttributes = new { @class = "form-control", placeholder = "Usuario o Admin" } })
                    @Html.ValidationMessageFor(model => model.TipoUsuario, "", new { @class = "text-danger" })
                    <p class="mt-2 text-warning fw-bold small">
                        ⚠️ Escriba exactamente <strong>"Usuario"</strong> o <strong>"Admin"</strong>.
                        Si ingresa otro valor, la página no funcionará correctamente.
                    </p>
                </div>

                <div class="text-center mt-4">
                    <input type="submit" value="✅ Crear Usuario" class="btn btn-success px-4 fw-bold" />
                    @Html.ActionLink("⬅️ Volver", "Index", "Usuarios", null, new { @class = "btn btn-secondary px-4 fw-bold ms-2" })
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<style>
    .glass-card-crear {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(12px);
        border-radius: 1.5rem;
        padding: 2.5rem 2rem;
        color: white;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.4);
        transition: all 0.3s ease;
    }

        .glass-card-crear:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
        }

    .form-control {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.4);
        color: white;
    }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

    .btn {
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: scale(1.05);
        }
</style>
